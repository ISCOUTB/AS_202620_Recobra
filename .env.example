PORT=3000
# Opcional: si se define, el backend usa PostgreSQL (ver ADR-0006) en vez del
# adaptador en memoria. Nunca pongas aquí un valor real — va en el panel de
# Render (o en tu .env local, que está en .gitignore).
DATABASE_URL=
# TLS hacia la base: por omisión activo (Neon lo exige). Poner false solo para
# una base interna sin TLS, como el PostgreSQL del mismo proyecto de Dokploy.
# DATABASE_SSL=false

# Correos @utb.edu.co (separados por comas) de quienes pueden resolver reportes de
# abuso (ADR-0022). Sin esto nadie es administrador.
# ADMIN_CORREOS=
# Canal de contacto que muestra el aviso de privacidad (por ejemplo, un correo del equipo).
# CONTACTO_PRIVACIDAD=
# Días sin movimiento antes de cerrar una publicación sola (60 por omisión).
# DIAS_VIGENCIA_PUBLICACION=

# Orígenes (separados por comas) que pueden leer la API desde un navegador de otro sitio. Vacío: ninguno.
# CORS_ORIGENES=
# Saltos de proxy de confianza para conocer la IP real del cliente (1 detrás de Traefik; 0 sin proxy).
# PROXY_CONFIABLES=
